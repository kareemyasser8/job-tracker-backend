# ─── Testing (ephemeral e2e) ────────────────────────────────────────────────────
# Copy once:  cp .env.test.example .env.test
# Wiped with: docker compose -f docker-compose.test.yml down -v
#
# Generate secrets with:  openssl rand -base64 64

# Isolated from dev: different db name, host port 5433.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=job_tracker_test

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/job_tracker_test

PORT=3000

# Must differ from dev/prod so a leaked test token is useless elsewhere.
JWT_ACCESS_SECRET=test-access-secret-REPLACE-ME
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=test-refresh-secret-REPLACE-ME
JWT_REFRESH_EXPIRATION=7d

CORS_ORIGIN=http://localhost:5173
