# ─── Production ─────────────────────────────────────────────────────────────────
# Copy once:  cp .env.prod.example .env.prod   then fill in REAL secrets.
# NEVER commit .env.prod. On a server, prefer your host's secret manager
# (or `docker compose --env-file`) over a file on disk.
#
# Generate secrets with:  openssl rand -base64 64

# Strong unique password required. Different db name so a mispointed
# dev/test container can never touch prod tables.
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=CHANGE-ME-strong-random-password
POSTGRES_DB=job_tracker_prod

DATABASE_URL=postgresql://jobtracker:CHANGE-ME-strong-random-password@postgres:5432/job_tracker_prod

PORT=3000

JWT_ACCESS_SECRET=CHANGE-ME-openssl-rand-base64-64
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=CHANGE-ME-openssl-rand-base64-64
JWT_REFRESH_EXPIRATION=7d

# Comma-separated frontend origin(s) for Render/hosted frontend.
# e.g. CORS_ORIGIN=https://job-tracker-frontend.vercel.app
CORS_ORIGIN=
