// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

enum Currency {
  USD
  EUR
  GBP
  EGP
  CAD
  AUD
  INR
  JPY
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  FREELANCE
  INTERNSHIP
  TEMPORARY
}

enum ApplicationStatus {
  WISHLIST
  APPLIED
  PHONE_SCREEN
  INTERVIEWING
  OFFER
  REJECTED
  GHOSTED
  ACCEPTED
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  firstName    String @db.VarChar(100)
  lastName     String @db.VarChar(100)
  email        String @unique @db.VarChar(255)
  passwordHash String

  createdAt DateTime @default(now())

  preferences  Preference?
  sources      Source[]
  companies    Company[]
  roles        Role[]
  technologies Technology[]
  applications Application[]
}

model Preference {
  userId String @id @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  isDarkMode   Boolean @default(false)
  isGridLayout Boolean @default(false)
}

model Source {
  id      String  @id @default(uuid()) @db.Uuid
  ownerId String? @db.Uuid
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  isVerified Boolean @default(false)

  name String @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
}

model Company {
  id      String  @id @default(uuid()) @db.Uuid
  ownerId String? @db.Uuid
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name           String  @db.VarChar(100)
  normalizedName String  @db.VarChar(100)
  domain         String? @unique @db.VarChar(50)
  location       String?
  logoUrl        String?
  isVerified     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
}

model Role {
  id      String  @id @default(uuid()) @db.Uuid
  ownerId String? @db.Uuid
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  isVerified Boolean @default(false)

  name String @unique @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications Application[]
}

model Technology {
  id      String  @id @default(uuid()) @db.Uuid
  ownerId String? @db.Uuid
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  isVerified Boolean @default(false)

  name String @unique @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applicationTechnologies ApplicationTechnology[]
}

model Application {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id])

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  sourceId String @db.Uuid
  source   Source @relation(fields: [sourceId], references: [id])

  status   ApplicationStatus @default(APPLIED)
  position Int               @default(1000)

  title          String         @db.VarChar(150)
  description    String?
  jobUrl         String?
  workMode       WorkMode
  employmentType EmploymentType
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency Currency?

  appliedAt DateTime
  createdAt DateTime @default(now())

  technologies ApplicationTechnology[]
  notes        ApplicationNote[]
}

model ApplicationTechnology {
  applicationId String      @db.Uuid
  technologyId  String      @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  technology    Technology  @relation(fields: [technologyId], references: [id])

  @@id([applicationId, technologyId])
}

model ApplicationNote {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  content   String
  createdAt DateTime @default(now())
}
