# ─── Development (local, hot-reload) ────────────────────────────────────────────
# Copy once:  cp .env.dev.example .env.dev
# Compose loads it via `env_file`. Never commit the real .env.dev.
#
# Generate secrets with:  openssl rand -base64 64

# Postgres container (host port 5432). Weak defaults are fine here —
# dev data is disposable and never exposed beyond localhost.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=job_tracker_dev

# App container (host port 3000). Hostname `postgres` = the db service name.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/job_tracker_dev

PORT=3000

JWT_ACCESS_SECRET=dev-access-secret-REPLACE-ME
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=dev-refresh-secret-REPLACE-ME
JWT_REFRESH_EXPIRATION=7d

# Comma-separated frontend origin(s). Empty = allow all (dev only).
CORS_ORIGIN=http://localhost:5173
